NODE_ENV=development

# Base URL (backend) (this)
BASE_URL=http://localhost:3000

# App base URL (frontend)
WEB_URL=http://localhost:3001

# Database connection (ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iskommerce

# Direct database connection (migrations/tools)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/iskommerce

# Auth secret (keep private, use strong random value in prod)
BETTER_AUTH_SECRET=astrongbetterauthsecret

# Auth service URL
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Port
PORT=3000

# Uploads
UPLOAD_DRIVER=local # or =s3

# Local upload directory
UPLOAD_DIR=uploads

# S3 (optional)
S3_REGION=auto
S3_BUCKET=my-bucket
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=xxx
S3_SECRET_ACCESS_KEY=xxx
S3_PUBLIC_URL=https://cdn.example.com
